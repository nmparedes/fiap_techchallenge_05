{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "noEmit": true
  },
  "include": [
    "jest.config.js",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.js",
    "packages/**/*.ts",
    "packages/**/*.tsx"
  ],
  "exclude": ["node_modules", "**/dist/**", "**/coverage/**"]
}
