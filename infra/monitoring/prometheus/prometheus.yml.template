global:
  scrape_interval: 15s
  scrape_timeout: 5s

scrape_configs:
  - job_name: auth-service
    metrics_path: /metrics
    static_configs:
      - targets: ["__AUTH_METRICS_TARGET__"]

  - job_name: video-service
    metrics_path: /metrics
    static_configs:
      - targets: ["__VIDEO_METRICS_TARGET__"]

  - job_name: processor-service
    metrics_path: /metrics
    static_configs:
      - targets: ["__PROCESSOR_METRICS_TARGET__"]

  - job_name: notification-service
    metrics_path: /metrics
    static_configs:
      - targets: ["__NOTIFICATION_METRICS_TARGET__"]
