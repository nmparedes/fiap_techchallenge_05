{
  "name": "@fiap-x/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --project tsconfig.json --noEmit && vite build",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "format": "prettier --write . --ignore-path ../../.prettierignore --ignore-unknown",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore --ignore-unknown"
  },
  "devDependencies": {
    "vite": "8.3.0"
  }
}
