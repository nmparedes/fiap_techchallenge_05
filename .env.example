# Local MySQL server. The Auth Service always selects auth_db; MYSQL_DATABASE is for other services.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=fiap_x
MYSQL_PASSWORD=fiap_x_local_password
MYSQL_DATABASE=video_db
MYSQL_CONNECTION_LIMIT=10
MYSQL_SSL=false

# Auth Service HTTP and JWT settings. Use a randomly generated secret of at least 32 bytes.
AUTH_HOST=0.0.0.0
AUTH_PORT=3001
AUTH_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
AUTH_JWT_EXPIRES_IN_SECONDS=3600
AUTH_JWT_ISSUER=fiap-x-auth-service
AUTH_JWT_AUDIENCE=fiap-x-api

# Video Service HTTP and local shared-storage settings.
VIDEO_HOST=0.0.0.0
VIDEO_PORT=3002
VIDEO_STORAGE_ROOT=./storage

# Processor Service internal HTTP and lifecycle settings.
PROCESSOR_PORT=3003
PROCESSOR_PREFETCH=1
PROCESSOR_SHUTDOWN_TIMEOUT_MS=10000

# Notification Service HTTP and listing settings.
NOTIFICATION_PORT=3004
NOTIFICATION_DEFAULT_PAGE_SIZE=20
NOTIFICATION_MAXIMUM_PAGE_SIZE=100

REDIS_URL=redis://127.0.0.1:6379
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672

# Local monitoring stack. Targets must be reachable from the Prometheus container.
MONITORING_AUTH_TARGET=host.docker.internal:3001
MONITORING_VIDEO_TARGET=host.docker.internal:3002
MONITORING_PROCESSOR_TARGET=host.docker.internal:3003
MONITORING_NOTIFICATION_TARGET=host.docker.internal:3004
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=fiap-x-admin
